# Copy to .env and customize. Never commit real credentials.
GRIMARR_PASSWORD=replace-this-with-a-long-unique-password
PUID=1000
PGID=1000
# Set your Ubuntu LAN or Tailscale IP to access Grimarr from other devices.
# 127.0.0.1 limits access to the Ubuntu host itself.
GRIMARR_BIND_IP=127.0.0.1
GRIMARR_PORT=8787
GRIMARR_CONFIG_DIR=./config
GRIMARR_DATA_DIR=/srv/media
